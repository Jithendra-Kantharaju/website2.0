{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "types": [
      "node",
      "react"
    ],
    "noEmit": true,
    "jsx": "preserve",
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "src/**/*.js",
    "src/**/*.jsx",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "out"
  ]
}
